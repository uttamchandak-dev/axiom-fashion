// This is your Prisma schema file for AXIOM Fashion E-Commerce (MySQL)
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Products & Catalog ───────────────────────────────────────────────────────

model Product {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  description    String   @db.Text
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  category       String   @db.VarChar(100)
  collectionId   String?  @db.VarChar(100)
  images         Json // Array of image URLs
  materials      Json // Array of material strings
  tags           Json // Array of search/filter tags
  featured       Boolean  @default(false)
  status         String   @default("active") @db.VarChar(50)
  rating         Decimal  @default(5.0) @db.Decimal(3, 2)
  reviewCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  collection Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  colors     ProductColor[]
  sizes      ProductSize[]
  model3D    Model3D?
  orderItems OrderItem[]
  Review     Review[]

  @@index([category])
  @@index([featured])
  @@index([collectionId])
  @@map("products")
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  name      String  @db.VarChar(100)
  hex       String  @db.VarChar(20)
  image     String? @db.VarChar(500)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_colors")
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  name      String  @db.VarChar(20)
  available Boolean @default(true)
  chest     String? @db.VarChar(50)
  waist     String? @db.VarChar(50)
  hips      String? @db.VarChar(50)
  length    String? @db.VarChar(50)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_sizes")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  color     String  @db.VarChar(100)
  size      String  @db.VarChar(20)
  sku       String  @unique @db.VarChar(100)
  price     Decimal @db.Decimal(10, 2)
  inventory Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ─── 3D Engine & Digital Assets ───────────────────────────────────────────────

model Model3D {
  id           String   @id @default(cuid())
  productId    String   @unique
  desktopModel String?  @db.VarChar(500) // GLB/GLTF url
  mobileModel  String?  @db.VarChar(500)
  thumbnail    String?  @db.VarChar(500)
  fabricType   String   @default("wool") @db.VarChar(50)
  roughness    Decimal  @default(0.85) @db.Decimal(3, 2)
  metalness    Decimal  @default(0.05) @db.Decimal(3, 2)
  createdAt    DateTime @default(now())

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  hotspots ModelHotspot[]

  @@map("models_3d")
}

model ModelHotspot {
  id          String  @id @default(cuid())
  modelId     String
  label       String  @db.VarChar(100)
  description String  @db.Text
  posX        Decimal @db.Decimal(6, 3)
  posY        Decimal @db.Decimal(6, 3)
  posZ        Decimal @db.Decimal(6, 3)
  targetX     Decimal @db.Decimal(6, 3)
  targetY     Decimal @db.Decimal(6, 3)
  targetZ     Decimal @db.Decimal(6, 3)
  camX        Decimal @db.Decimal(6, 3)
  camY        Decimal @db.Decimal(6, 3)
  camZ        Decimal @db.Decimal(6, 3)

  model Model3D @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("model_hotspots")
}

// ─── Collections & Lookbooks ──────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String   @db.Text
  heroImage   String   @db.VarChar(500)
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now())

  products Product[]

  @@map("collections")
}

model Lookbook {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  description String   @db.Text
  coverImage  String   @db.VarChar(500)
  createdAt   DateTime @default(now())

  looks Look[]

  @@map("lookbooks")
}

model Look {
  id          String @id @default(cuid())
  lookbookId  String
  number      Int
  title       String @db.VarChar(255)
  description String @db.Text
  image       String @db.VarChar(500)
  productIds  Json // Array of product IDs

  lookbook Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)

  @@index([lookbookId])
  @@map("looks")
}

// ─── Admin Users ──────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  role         String    @default("admin") @db.VarChar(50) // super_admin, admin, viewer
  avatar       String?   @db.VarChar(500)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model Review {
  id         String  @id @default(cuid())
  rating     Int
  authorName String
  content    String  @db.Text
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("reviews")
}

// ─── Customers & Orders ───────────────────────────────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  phone        String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  addresses Address[]
  orders    Order[]

  @@map("customers")
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  firstName  String  @db.VarChar(100)
  lastName   String  @db.VarChar(100)
  address1   String  @db.VarChar(255)
  address2   String? @db.VarChar(255)
  city       String  @db.VarChar(100)
  state      String  @db.VarChar(100)
  zip        String  @db.VarChar(20)
  country    String  @default("US") @db.VarChar(10)
  phone      String? @db.VarChar(50)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique @db.VarChar(50)
  customerId      String?
  subtotal        Decimal  @db.Decimal(10, 2)
  shipping        Decimal  @default(0.00) @db.Decimal(10, 2)
  tax             Decimal  @default(0.00) @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  status          String   @default("pending") @db.VarChar(50)
  deliveryMethod  String   @default("express") @db.VarChar(50)
  shippingAddress Json // Snapshot of delivery address
  billingAddress  Json? // Snapshot of billing address
  paymentMethod   String   @default("credit_card") @db.VarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([orderNumber])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String  @db.VarChar(255)
  color     String  @db.VarChar(100)
  size      String  @db.VarChar(20)
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)
  image     String  @db.VarChar(500)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}
